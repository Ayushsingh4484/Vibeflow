# VibeFlow Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite by default, or PostgreSQL: postgresql://user:password@localhost:5432/vibeflow?schema=public)
DATABASE_URL="file:./prisma/dev.db"

# Authentication
JWT_SECRET="vibeflow_super_secret_jwt_key_2026_production_grade"
JWT_EXPIRES_IN="7d"

# Storage Settings (local / supabase / cloudinary / s3)
STORAGE_TYPE=local
STORAGE_BASE_URL=http://localhost:5000/uploads
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=

# Jamendo Music API (Get your free client_id from https://devportal.jamendo.com/)
JAMENDO_CLIENT_ID=your_client_id_here
